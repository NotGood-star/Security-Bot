DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_discord_application_client_id
CLIENT_SECRET=your_discord_application_client_secret
GUILD_ID=destination_server_id
ANNOUNCEMENT_CHANNEL_ID=announcement_channel_id
# Full public URL to your Render web service, e.g. https://your-service.onrender.com
BASE_URL=https://your-service.onrender.com
# Must exactly match the Redirect URL in Discord Developer Portal
OAUTH_REDIRECT_URI=https://your-service.onrender.com/oauth/callback
# Optional comma-separated user IDs allowed to use admin commands
ADMIN_USER_IDS=
# Optional log channel ID
LOG_CHANNEL_ID=
DM_BATCH_SIZE=5
DM_BATCH_DELAY_MS=3000
PORT=3000
